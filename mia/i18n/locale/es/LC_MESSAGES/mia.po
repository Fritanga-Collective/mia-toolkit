msgid "This will help you, step by step:"
msgstr "Esto te ayudará, paso a paso:"

#: mia/gui/wizard/steps.py:117
msgid ""
"1.  Add your studies — CDs, USB folders, or ZIP downloads\n"
"2.  Review everything we found\n"
"3.  Add any report or lab PDFs (optional)\n"
"4.  Build one archive and copy it to a USB drive for your doctor"
msgstr ""
"1.  Agrega tus estudios — CDs, carpetas USB o descargas ZIP\n"
"2.  Revisa todo lo que encontramos\n"
"3.  Agrega informes o PDF de laboratorio (opcional)\n"
"4.  Crea un solo archivo y cópialo a una USB para tu médico"

#: mia/gui/wizard/steps.py:125
msgid "Skip to building the archive"
msgstr "Saltar a crear el archivo"

#: mia/gui/wizard/steps.py:132
#, python-brace-format
msgid ""
"Welcome back — you already have {n} disc(s) copied. Continue with Next, or:"
msgstr ""
"Bienvenido de nuevo — ya tienes {n} disco(s) copiado(s). Continúa con "
"Siguiente, o:"

#: mia/gui/wizard/steps.py:145
msgid ""
"Insert each CD — it copies and ejects automatically. You can also add "
"studies from a USB drive, a folder, or a ZIP downloaded from a hospital "
"portal. When everything's added, click Next."
msgstr ""
"Inserta cada CD — se copia y expulsa automáticamente. También puedes agregar"
" estudios desde una memoria USB, una carpeta o un ZIP descargado del portal "
"del hospital. Cuando hayas agregado todo, haz clic en Siguiente."

#: mia/gui/wizard/steps.py:178
msgid "Ready. Insert a disc, then click Start ripping."
msgstr "Listo. Inserta un disco y luego haz clic en Empezar a copiar."

#: mia/gui/wizard/steps.py:223
#, python-brace-format
msgid "Found {n} report PDF(s) — review them in ‘Add documents’."
msgstr ""
"Se encontraron {n} PDF de informes — revísalos en ‘Agregar documentos’."

#: mia/gui/wizard/steps.py:231
#, python-brace-format
msgid "Sources added so far: {n}"
msgstr "Fuentes agregadas hasta ahora: {n}"

#: mia/gui/wizard/steps.py:271
msgid "Re-scan"
msgstr "Volver a revisar"

#: mia/gui/wizard/steps.py:273
msgid "Open spreadsheet"
msgstr "Abrir hoja de cálculo"

#: mia/gui/wizard/steps.py:282
msgid "No discs copied yet — you can skip this step."
msgstr "Aún no hay discos copiados — puedes omitir este paso."

#: mia/gui/wizard/steps.py:290
msgid "Looking through your discs…"
msgstr "Revisando tus discos…"

#: mia/gui/wizard/steps.py:307
#, python-brace-format
msgid "We found {n} studies across your discs."
msgstr "Encontramos {n} estudios en tus discos."

#: mia/gui/wizard/steps.py:317
msgid ""
"⚠ More than one patient appears across these discs. Open the spreadsheet's "
"‘Consistency Check’ to be sure a stranger's disc wasn't mixed in (often it's"
" just the same person registered differently)."
msgstr ""
"⚠ Aparece más de un paciente en estos discos. Abre la hoja «Consistency "
"Check» (verificación de consistencia) para asegurarte de que no se mezcló el"
" disco de un desconocido (a menudo es la misma persona registrada de forma "
"distinta)."

#: mia/gui/wizard/steps.py:378
msgid ""
"Add the radiologist's report or lab/blood-work results (PDFs). They travel "
"with the scans as files your doctor can open, and PDFs can also be embedded "
"into the imaging archive for a PACS. Optional — click Next to skip."
msgstr ""
"Agrega el informe del radiólogo o los resultados de laboratorio/análisis de "
"sangre (PDF). Viajan con los estudios como archivos que tu médico puede "
"abrir, y los PDF también pueden incrustarse en el archivo de imágenes para "
"un PACS. Opcional: haz clic en Siguiente para omitir."

#: mia/gui/wizard/steps.py:383
msgid "Add files…"
msgstr "Agregar archivos…"

#: mia/gui/wizard/steps.py:389
msgid "No documents added yet."
msgstr "Aún no se agregaron documentos."

#: mia/gui/wizard/steps.py:397
msgid "Just include the file"
msgstr "Solo incluir el archivo"

#: mia/gui/wizard/steps.py:400
msgid "Skip this file"
msgstr "Omitir este archivo"

#: mia/gui/wizard/steps.py:440 mia/gui/wizard/steps.py:786
msgid "Choose reports or documents"
msgstr "Elige informes o documentos"

#: mia/gui/wizard/steps.py:441 mia/gui/wizard/steps.py:787
msgid "Documents"
msgstr "Documentos"

#: mia/gui/wizard/steps.py:509
msgid "Can't open file"
msgstr "No se puede abrir el archivo"

#: mia/gui/wizard/steps.py:510
#, python-brace-format
msgid ""
"This file can no longer be found:\n"
"{p}"
msgstr ""
"Este archivo ya no se encuentra:\n"
"{p}"

#: mia/gui/wizard/steps.py:535
msgid "Build the archive"
msgstr "Crear el archivo"

#: mia/gui/wizard/steps.py:538
msgid "Choose USB & copy"
msgstr "Elegir USB y copiar"

#: mia/gui/wizard/steps.py:546
msgid "No discs to build from. Go back and rip some discs first."
msgstr ""
"No hay discos para crear el archivo. Regresa y copia algunos discos primero."

#: mia/gui/wizard/steps.py:552
msgid "Archive already built. Choose a USB drive to copy it to."
msgstr "El archivo ya está creado. Elige una memoria USB para copiarlo."

#: mia/gui/wizard/steps.py:556
msgid "Ready to combine your discs into one archive."
msgstr "Listo para combinar tus discos en un solo archivo."

#: mia/gui/wizard/steps.py:596
#, python-brace-format
msgid ""
"Couldn't embed {name} into the archive — it's still included as a file."
msgstr ""
"No se pudo incrustar {name} en el archivo — se incluye igualmente como "
"archivo."

#: mia/gui/wizard/steps.py:605
#, python-brace-format
msgid "Archive built: {s} studies, {n} images. Now copy it to a USB drive."
msgstr ""
"Archivo creado: {s} estudios, {n} imágenes. Ahora cópialo a una memoria USB."

#: mia/gui/wizard/steps.py:631
msgid "Study"
msgstr "Estudio"

#: mia/gui/wizard/steps.py:632
#, python-brace-format
msgid "{name} ({count} images)"
msgstr "{name} ({count} imágenes)"

#: mia/gui/wizard/steps.py:634
#, python-brace-format
msgid "Copying study {i} of {n}: {label}…"
msgstr "Copiando estudio {i} de {n}: {label}…"

#: mia/gui/wizard/steps.py:640
msgid "Choose your USB drive"
msgstr "Elige tu memoria USB"

#: mia/gui/wizard/steps.py:647
#, python-brace-format
msgid "That drive doesn't have room for the archive (need about {n})."
msgstr "Esa unidad no tiene espacio para el archivo (se necesitan unos {n})."

#: mia/gui/wizard/steps.py:704
msgid "✓ Copied to the USB and verified. Click Next to finish."
msgstr "✓ Copiado a la USB y verificado. Haz clic en Siguiente para terminar."

#: mia/gui/wizard/steps.py:707
#, python-brace-format
msgid "Copied with {f} problem file(s) — see technical details."
msgstr "Copiado con {f} archivo(s) con problemas — ver detalles técnicos."

#: mia/gui/wizard/steps.py:719
msgid "Show the files on the USB"
msgstr "Mostrar los archivos en la USB"

#: mia/gui/wizard/steps.py:722
msgid "Open the inventory"
msgstr "Abrir el inventario"

#: mia/gui/wizard/steps.py:726 mia/gui/wizard/steps.py:801
msgid "Add more files to the USB"
msgstr "Agregar más archivos a la USB"

#: mia/gui/wizard/steps.py:730
msgid ""
"Tip: include a one-page cover note with the patient's name, date of birth, a"
" short history, and the specific questions you want the radiologist to "
"answer."
msgstr ""
"Consejo: incluye una nota de una página con el nombre del paciente, la fecha"
" de nacimiento, un breve historial y las preguntas específicas que quieres "
"que responda el radiólogo."

#: mia/gui/wizard/steps.py:740
msgid ""
"Was this useful? This tool is free and always will be. If it helped you, you"
" can buy the dev team a coffee — it keeps the project alive and free for "
"families who can't pay."
msgstr ""
"¿Te resultó útil? Esta herramienta es gratuita y siempre lo será. Si te "
"ayudó, puedes invitarle un café al equipo — eso mantiene el proyecto vivo y "
"gratis para las familias que no pueden pagar."

#: mia/gui/wizard/steps.py:746
msgid "☕  Buy us a coffee"
msgstr "☕  Invítanos un café"

#: mia/gui/wizard/steps.py:756
msgid ""
"Deploying at a clinic or hospital? Institutional licenses fund free access "
"for patients →"
msgstr ""
"¿Lo usarán en una clínica u hospital? Las licencias institucionales "
"financian el acceso gratuito de los pacientes →"

#: mia/gui/wizard/steps.py:771
#, python-brace-format
msgid ""
"All done! Your archive is on the USB drive at:\n"
"{p}\n"
"\n"
"You can now hand it to your doctor."
msgstr ""
"¡Listo! Tu archivo está en la memoria USB en:\n"
"{p}\n"
"\n"
"Ya puedes entregárselo a tu médico."

#: mia/gui/wizard/steps.py:776
msgid "All done."
msgstr "¡Listo!"

#: mia/gui/wizard/steps.py:794
#, python-brace-format
msgid "Copied {n} file(s) to the USB."
msgstr "Se copiaron {n} archivo(s) a la USB."

#: mia/gui/wizard/steps.py:796
#, python-brace-format
msgid "{f} file(s) could not be copied."
msgstr "No se pudieron copiar {f} archivo(s)."

#: mia/gui/wizard/steps.py:798
msgid ""
"To embed reports into the DICOM archive for a PACS, add them before "
"building."
msgstr ""
"Para incrustar informes en el archivo DICOM para un PACS, agrégalos antes de"
" construir."

#: mia/gui/wizard/view.py:14
msgid "Welcome"
msgstr "Bienvenida"

#: mia/gui/wizard/view.py:14
msgid "Add your studies"
msgstr "Agrega tus estudios"

#: mia/gui/wizard/view.py:14
msgid "Review"
msgstr "Revisar"

#: mia/gui/wizard/view.py:15
msgid "Add documents"
msgstr "Agregar documentos"

#: mia/gui/wizard/view.py:15
msgid "Build & deliver"
msgstr "Crear y entregar"

#: mia/gui/wizard/view.py:15
msgid "Done"
msgstr "Listo"

#: mia/gui/wizard/view.py:57
msgid "Exit to Home"
msgstr "Salir al inicio"

#: mia/gui/wizard/view.py:60 mia/gui/wizard/view.py:140
msgid "Next ›"
msgstr "Siguiente ›"

#: mia/gui/wizard/view.py:96
#, python-brace-format
msgid "Step {n} of {m}:  {t}"
msgstr "Paso {n} de {m}:  {t}"

#: mia/gui/wizard/view.py:140
msgid "Finish"
msgstr "Finalizar"

