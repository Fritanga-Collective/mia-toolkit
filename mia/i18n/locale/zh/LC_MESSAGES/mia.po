#: mia/gui/rip_session.py:53
msgid "Please choose a folder to save copies to."
msgstr "请选择保存副本的文件夹。"

#: mia/gui/rip_session.py:58
msgid "Couldn't create that folder. Choose another."
msgstr "无法创建该文件夹。请另选一个。"

