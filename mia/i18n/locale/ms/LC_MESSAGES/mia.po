#: mia/gui/rip_session.py:53
msgid "Please choose a folder to save copies to."
msgstr "Sila pilih folder untuk menyimpan salinan."

#: mia/gui/rip_session.py:58
msgid "Couldn't create that folder. Choose another."
msgstr "Tidak dapat membuat folder itu. Sila pilih yang lain."

#: mia/gui/rip_session.py:66
msgid "Insert a disc…"
msgstr "Masukkan cakera…"

#: mia/gui/rip_session.py:67
msgid "Ripping session started. Insert your first disc."
msgstr "Sesi menyalin telah bermula. Masukkan cakera pertama anda."

#: mia/gui/rip_session.py:75 mia/gui/task_view.py:112
msgid "Stopping…"
msgstr "Sedang berhenti…"

#: mia/gui/rip_session.py:86
msgid "Ripping session ended. {n} disc(s) copied."
msgstr "Sesi menyalin telah tamat. {n} cakera telah disalin."

#: mia/gui/rip_session.py:100
msgid "Insert a disc… (waiting)"
msgstr "Masukkan cakera… (menunggu)"

#: mia/gui/rip_session.py:117
msgid "Ripping disc {n}: {name}…"
msgstr "Menyalin cakera {n}: {name}…"

#: mia/gui/rip_session.py:118
msgid "Found disc “{name}”. Copying…"
msgstr "Cakera “{name}” dijumpai. Sedang menyalin…"

#: mia/gui/rip_session.py:134 mia/gui/task_view.py:99
msgid "Stopped."
msgstr "Telah berhenti."

#: mia/gui/rip_session.py:140
msgid "Couldn't rip this disc. Remove it and insert another, or press Stop."
msgstr ""
"Tidak dapat menyalin cakera ini. Keluarkannya dan masukkan yang lain, atau "
"tekan Berhenti."

#: mia/gui/rip_session.py:146
msgid "✓ Disc copied: {c} files OK, {r} recovered, {f} could not be read."
msgstr ""
"✓ Cakera telah disalin: {c} fail OK, {r} dipulihkan, {f} tidak dapat dibaca."

#: mia/gui/rip_session.py:153
msgid "✓ Disc {n} done. Insert the next disc…"
msgstr "✓ Cakera {n} selesai. Masukkan cakera seterusnya…"

#: mia/gui/rip_session.py:162
msgid "Choose a disc"
msgstr "Pilih cakera"

#: mia/gui/rip_session.py:166
msgid "More than one drive looks like a disc. Which one should I copy?"
msgstr ""
"Lebih daripada satu pemacu kelihatan seperti cakera. Yang mana satu perlu "
"saya salin?"

#: mia/gui/rip_session.py:180
msgid "Rip this one"
msgstr "Salin yang ini"

#: mia/gui/rip_session.py:182
msgid "Skip for now"
msgstr "Langkau buat masa ini"

#: mia/gui/task_view.py:38 mia/gui/wizard/view.py:58
msgid "‹ Back"
msgstr "‹ Kembali"

#: mia/gui/task_view.py:54
msgid "Stop"
msgstr "Berhenti"

#: mia/gui/task_view.py:97
msgid "Stopped on an error."
msgstr "Berhenti kerana ralat."

#: mia/gui/task_view.py:100
msgid "Stopped by you."
msgstr "Dihentikan oleh anda."

#: mia/gui/widgets.py:32
msgid "Choose…"
msgstr "Pilih…"

#: mia/gui/progress_panel.py:40
msgid "Ready."
msgstr "Sedia."

#: mia/gui/progress_panel.py:62 mia/gui/progress_panel.py:205
msgid "▸ Show technical details"
msgstr "▸ Tunjukkan butiran teknikal"

#: mia/gui/progress_panel.py:79
msgid "Save log…"
msgstr "Simpan log…"

#: mia/gui/progress_panel.py:81
msgid "Open log folder"
msgstr "Buka folder log"

#: mia/gui/progress_panel.py:91
msgid "Writing the archive… this can take several minutes."
msgstr "Sedang menulis arkib… ini boleh mengambil masa beberapa minit."

#: mia/gui/progress_panel.py:92
msgid "Writing the archive now. This can take several minutes — please wait…"
msgstr ""
"Sedang menulis arkib sekarang. Ini boleh mengambil masa beberapa minit — "
"sila tunggu…"

#: mia/gui/progress_panel.py:134
msgid "files {done}/{total}"
msgstr "fail {done}/{total}"

#: mia/gui/progress_panel.py:137
msgid "elapsed {t}"
msgstr "berlalu {t}"

#: mia/gui/progress_panel.py:139
msgid "ETA {t}"
msgstr "ETA {t}"

#: mia/gui/progress_panel.py:141
msgid "{r:.0f}/s"
msgstr "{r:.0f}/s"

#: mia/gui/progress_panel.py:196
msgid "▾ Hide technical details"
msgstr "▾ Sembunyikan butiran teknikal"

#: mia/gui/progress_panel.py:209
msgid "Save technical log"
msgstr "Simpan log teknikal"

#: mia/gui/rip_view.py:23
msgid "Save copies to:"
msgstr "Simpan salinan ke:"

#: mia/gui/rip_view.py:27 mia/gui/wizard/steps.py:132
msgid "Start ripping"
msgstr "Mula menyalin"

#: mia/gui/messages.py:61
msgid "Recovered a file after a retry."
msgstr "Berjaya memulihkan satu fail selepas cubaan semula."

#: mia/gui/messages.py:63
msgid "⚠ Could not read a file (see technical details)."
msgstr "⚠ Tidak dapat membaca satu fail (lihat butiran teknikal)."

#: mia/gui/messages.py:69
msgid "Copying file {done} of {total}…"
msgstr "Menyalin fail {done} daripada {total}…"

#: mia/gui/messages.py:71
msgid "Scanning file {done} of {total}…"
msgstr "Mengimbas fail {done} daripada {total}…"

#: mia/gui/messages.py:73
msgid "Indexing image {done} of {total}…"
msgstr "Mengindeks imej {done} daripada {total}…"

#: mia/gui/messages.py:75
msgid "Working… {done} of {total}"
msgstr "Sedang bekerja… {done} daripada {total}"

#: mia/gui/messages.py:82
msgid ""
"Permission denied. The destination may be read-only or locked. Try a "
"different folder, or check the drive isn't write-protected."
msgstr ""
"Kebenaran ditolak. Destinasi mungkin baca-sahaja atau dikunci. Cuba folder "
"lain, atau periksa sama ada pemacu itu dilindungi daripada penulisan."

#: mia/gui/messages.py:85
msgid ""
"A needed file or folder was not found. A disc may have been ejected too "
"early, or a folder was moved."
msgstr ""
"Fail atau folder yang diperlukan tidak dijumpai. Mungkin sebuah cakera telah"
" dikeluarkan terlalu awal, atau sebuah folder telah dipindahkan."

#: mia/gui/messages.py:88
msgid "The disk is full. Free up space or choose a drive with more room."
msgstr ""
"Cakera sudah penuh. Kosongkan ruang atau pilih pemacu yang ada lebih banyak "
"ruang."

#: mia/gui/messages.py:90
msgid "That location is read-only. Choose a different destination folder."
msgstr "Lokasi itu baca-sahaja. Pilih folder destinasi yang lain."

#: mia/gui/messages.py:91
msgid "Something went wrong. See the technical details below."
msgstr "Ada sesuatu yang tidak kena. Lihat butiran teknikal di bawah."

#: mia/gui/app.py:15 mia/gui/app.py:55 mia/gui/launcher.py:27
msgid "MIA Toolkit"
msgstr "MIA Toolkit"

#: mia/gui/launcher.py:28
msgid "Organize your imaging CDs into one archive for your doctor."
msgstr "Susun CD pengimejan anda menjadi satu arkib untuk doktor anda."

#: mia/gui/launcher.py:33
msgid "Walk me through it, step by step (recommended)."
msgstr "Bimbing saya langkah demi langkah (disyorkan)."

#: mia/gui/launcher.py:36
msgid "Or use a single tool:"
msgstr "Atau guna satu alat sahaja:"

#: mia/gui/launcher.py:40 mia/gui/inventory_view.py:17
msgid "Build Inventory"
msgstr "Bina Inventori"

#: mia/gui/launcher.py:41
msgid "List every study in a spreadsheet."
msgstr "Senaraikan setiap kajian dalam hamparan."

#: mia/gui/launcher.py:42 mia/gui/archive_view.py:16
msgid "Build Archive for Doctor"
msgstr "Bina Arkib untuk Doktor"

#: mia/gui/launcher.py:43
msgid "Combine everything onto a USB drive."
msgstr "Gabungkan semuanya ke dalam pemacu USB."

#: mia/gui/launcher.py:50
msgid "Language:"
msgstr "Bahasa:"

#: mia/gui/inventory_view.py:21
msgid ""
"Pick the folder of ripped discs. A spreadsheet of every study will be "
"created inside it and opened for you."
msgstr ""
"Pilih folder cakera yang telah disalin. Satu hamparan bagi setiap kajian "
"akan dibuat di dalamnya dan dibuka untuk anda."

#: mia/gui/inventory_view.py:25 mia/gui/archive_view.py:24
msgid "Ripped discs folder:"
msgstr "Folder cakera yang telah disalin:"

#: mia/gui/inventory_view.py:29
msgid "Build inventory"
msgstr "Bina inventori"

#: mia/gui/inventory_view.py:41
msgid "Please choose a valid folder first."
msgstr "Sila pilih folder yang sah terlebih dahulu."

#: mia/gui/inventory_view.py:44
msgid "Scanning…"
msgstr "Mengimbas…"

#: mia/gui/inventory_view.py:45
msgid "Looking through {f} for studies…"
msgstr "Mencari kajian di dalam {f}…"

#: mia/gui/inventory_view.py:57
msgid "No DICOM studies found in that folder."
msgstr "Tiada kajian DICOM dijumpai dalam folder itu."

#: mia/gui/inventory_view.py:58
msgid "No studies found. Is this the folder with your ripped discs?"
msgstr ""
"Tiada kajian dijumpai. Adakah ini folder dengan cakera yang telah anda "
"salin?"

#: mia/gui/inventory_view.py:61
msgid "Done — {n} studies."
msgstr "Selesai — {n} kajian."

#: mia/gui/inventory_view.py:62
msgid "✓ Found {n} studies. Opening the spreadsheet…"
msgstr "✓ Menjumpai {n} kajian. Sedang membuka hamparan…"

#: mia/gui/archive_view.py:20
msgid ""
"Combine all your ripped discs into one archive the radiologist can open. "
"Choose where to save it — a USB drive is ideal."
msgstr ""
"Gabungkan semua cakera yang telah anda salin menjadi satu arkib yang boleh "
"dibuka oleh pakar radiologi. Pilih tempat untuk menyimpannya — pemacu USB "
"adalah paling sesuai."

#: mia/gui/archive_view.py:28
msgid "Save archive to:"
msgstr "Simpan arkib ke:"

#: mia/gui/archive_view.py:32
msgid "Build archive"
msgstr "Bina arkib"

#: mia/gui/archive_view.py:45
msgid "Please choose a valid ripped-discs folder."
msgstr "Sila pilih folder cakera-yang-disalin yang sah."

#: mia/gui/archive_view.py:48
msgid "Please choose where to save the archive."
msgstr "Sila pilih tempat untuk menyimpan arkib."

#: mia/gui/archive_view.py:51
msgid "That destination already has files in it."
msgstr "Destinasi itu sudah mempunyai fail di dalamnya."

#: mia/gui/archive_view.py:52
msgid ""
"⚠ The destination folder isn't empty. Choose an empty folder (or a new one) "
"so the archive stays clean."
msgstr ""
"⚠ Folder destinasi tidak kosong. Pilih folder yang kosong (atau yang baru) "
"supaya arkib kekal kemas."

#: mia/gui/archive_view.py:59
msgid "Scanning for images…"
msgstr "Mengimbas imej…"

#: mia/gui/archive_view.py:60
msgid "Looking for all DICOM images under {f}…"
msgstr "Mencari semua imej DICOM di dalam {f}…"

#: mia/gui/archive_view.py:73
msgid "No DICOM images found in that folder."
msgstr "Tiada imej DICOM dijumpai dalam folder itu."

#: mia/gui/archive_view.py:74
msgid "No images found. Is this the folder with your ripped discs?"
msgstr ""
"Tiada imej dijumpai. Adakah ini folder dengan cakera yang telah anda salin?"

#: mia/gui/archive_view.py:78
msgid "Archive ready — {s} studies, {n} images."
msgstr "Arkib sedia — {s} kajian, {n} imej."

#: mia/gui/archive_view.py:80
msgid ""
"✓ Archive complete: {s} studies, {n} images. Copy this folder to the USB "
"drive and hand it to the doctor."
msgstr ""
"✓ Arkib selesai: {s} kajian, {n} imej. Salin folder ini ke pemacu USB dan "
"serahkan kepada doktor."

#: mia/gui/archive_view.py:84
msgid "README: {p}"
msgstr "README: {p}"

#: mia/gui/wizard/steps.py:74 mia/gui/wizard/steps.py:291
msgid "Not enough space"
msgstr "Ruang tidak mencukupi"

#: mia/gui/wizard/steps.py:75
msgid ""
"This drive may not have enough room (need about {n}). Move your project to "
"another drive with more space?"
msgstr ""
"Pemacu ini mungkin tidak mempunyai ruang yang cukup (perlukan kira-kira "
"{n}). Pindahkan projek anda ke pemacu lain yang ada lebih banyak ruang?"

#: mia/gui/wizard/steps.py:78
msgid "Cancelled — not enough space."
msgstr "Dibatalkan — ruang tidak mencukupi."

#: mia/gui/wizard/steps.py:81
msgid "Choose a drive or folder with more space"
msgstr "Pilih pemacu atau folder yang ada lebih banyak ruang"

#: mia/gui/wizard/steps.py:83
msgid "Cancelled."
msgstr "Dibatalkan."

#: mia/gui/wizard/steps.py:94
msgid "Could not move the project. Try another drive."
msgstr "Tidak dapat memindahkan projek. Cuba pemacu lain."

#: mia/gui/wizard/steps.py:102
msgid "This will help you, step by step:"
msgstr "Ini akan membantu anda, langkah demi langkah:"

#: mia/gui/wizard/steps.py:111
msgid "Skip to building the archive"
msgstr "Langkau terus ke pembinaan arkib"

#: mia/gui/wizard/steps.py:118
msgid ""
"Welcome back — you already have {n} disc(s) copied. Continue with Next, or:"
msgstr ""
"Selamat kembali — anda sudah mempunyai {n} cakera yang disalin. Teruskan "
"dengan Seterusnya, atau:"

#: mia/gui/wizard/steps.py:145
msgid "Ready. Insert a disc, then click Start ripping."
msgstr "Sedia. Masukkan cakera, kemudian klik Mula menyalin."

#: mia/gui/wizard/steps.py:172
msgid "Re-scan"
msgstr "Imbas semula"

#: mia/gui/wizard/steps.py:174
msgid "Open spreadsheet"
msgstr "Buka hamparan"

#: mia/gui/wizard/steps.py:183
msgid "No discs copied yet — you can skip this step."
msgstr "Belum ada cakera yang disalin — anda boleh langkau langkah ini."

#: mia/gui/wizard/steps.py:191
msgid "Looking through your discs…"
msgstr "Sedang mencari di dalam cakera anda…"

#: mia/gui/wizard/steps.py:207
msgid "We found {n} studies across your discs."
msgstr "Kami menjumpai {n} kajian dalam cakera anda."

#: mia/gui/wizard/steps.py:217
msgid ""
"⚠ More than one patient appears across these discs. Open the spreadsheet's "
"‘Consistency Check’ to be sure a stranger's disc wasn't mixed in (often it's"
" just the same person registered differently)."
msgstr ""
"⚠ Lebih daripada seorang pesakit muncul dalam cakera-cakera ini. Buka "
"‘Semakan Ketekalan’ dalam hamparan untuk memastikan cakera orang lain tidak "
"tercampur (selalunya ia hanya orang yang sama tetapi didaftarkan dengan cara"
" berbeza)."

#: mia/gui/wizard/steps.py:233
msgid "Build the archive"
msgstr "Bina arkib"

#: mia/gui/wizard/steps.py:236
msgid "Choose USB & copy"
msgstr "Pilih USB & salin"

#: mia/gui/wizard/steps.py:244
msgid "No discs to build from. Go back and rip some discs first."
msgstr "Tiada cakera untuk dibina. Kembali dan salin beberapa cakera dahulu."

#: mia/gui/wizard/steps.py:250
msgid "Archive already built. Choose a USB drive to copy it to."
msgstr "Arkib sudah dibina. Pilih pemacu USB untuk menyalinnya."

#: mia/gui/wizard/steps.py:254
msgid "Ready to combine your discs into one archive."
msgstr "Sedia untuk menggabungkan cakera anda menjadi satu arkib."

#: mia/gui/wizard/steps.py:280
msgid "Archive built: {s} studies, {n} images. Now copy it to a USB drive."
msgstr "Arkib dibina: {s} kajian, {n} imej. Sekarang salin ia ke pemacu USB."

#: mia/gui/wizard/steps.py:285
msgid "Choose your USB drive"
msgstr "Pilih pemacu USB anda"

#: mia/gui/wizard/steps.py:292
msgid "That drive doesn't have room for the archive (need about {n})."
msgstr ""
"Pemacu itu tidak mempunyai ruang untuk arkib (perlukan kira-kira {n})."

#: mia/gui/wizard/steps.py:323
msgid "✓ Copied to the USB and verified. Click Next to finish."
msgstr "✓ Telah disalin ke USB dan disahkan. Klik Seterusnya untuk selesai."

#: mia/gui/wizard/steps.py:326
msgid "Copied with {f} problem file(s) — see technical details."
msgstr "Disalin dengan {f} fail bermasalah — lihat butiran teknikal."

#: mia/gui/wizard/steps.py:338
msgid "Show the files on the USB"
msgstr "Tunjukkan fail dalam USB"

#: mia/gui/wizard/steps.py:341
msgid "Open the inventory"
msgstr "Buka inventori"

#: mia/gui/wizard/steps.py:345
msgid ""
"Tip: include a one-page cover note with the patient's name, date of birth, a"
" short history, and the specific questions you want the radiologist to "
"answer."
msgstr ""
"Petua: sertakan satu muka surat nota ringkas dengan nama pesakit, tarikh "
"lahir, sejarah ringkas, dan soalan khusus yang anda ingin pakar radiologi "
"jawab."

#: mia/gui/wizard/steps.py:355
msgid ""
"Was this useful? This tool is free and always will be. If it helped you, you"
" can buy the dev team a coffee — it keeps the project alive and free for "
"families who can't pay."
msgstr ""
"Adakah ini berguna? Alat ini percuma dan akan sentiasa percuma. Jika ia "
"membantu anda, anda boleh belanja pasukan pembangun secawan kopi — ia "
"membantu projek ini terus hidup dan percuma untuk keluarga yang tidak mampu "
"membayar."

#: mia/gui/wizard/steps.py:359
msgid "☕  Buy us a coffee"
msgstr "☕  Belanja kami kopi"

#: mia/gui/wizard/steps.py:370
msgid ""
"All done! Your archive is on the USB drive at:\n"
"{p}\n"
"\n"
"You can now hand it to your doctor."
msgstr ""
"Semua selesai! Arkib anda ada dalam pemacu USB di:\n"
"{p}\n"
"\n"
"Anda kini boleh menyerahkannya kepada doktor anda."

#: mia/gui/wizard/steps.py:374
msgid "All done."
msgstr "Semua selesai."

#: mia/gui/wizard/view.py:14
msgid "Welcome"
msgstr "Selamat Datang"

#: mia/gui/wizard/view.py:14
msgid "Review"
msgstr "Semak"

#: mia/gui/wizard/view.py:15
msgid "Build & deliver"
msgstr "Bina & serah"

#: mia/gui/wizard/view.py:15
msgid "Done"
msgstr "Selesai"

#: mia/gui/wizard/view.py:41
msgid "Guided Setup"
msgstr "Persediaan Berpandu"

#: mia/gui/wizard/view.py:53
msgid "Exit to Home"
msgstr "Keluar ke Laman Utama"

#: mia/gui/wizard/view.py:56 mia/gui/wizard/view.py:131
msgid "Next ›"
msgstr "Seterusnya ›"

#: mia/gui/wizard/view.py:91
msgid "Step {n} of {m}:  {t}"
msgstr "Langkah {n} daripada {m}:  {t}"

#: mia/gui/wizard/view.py:131
msgid "Finish"
msgstr "Selesai"

#: mia/gui/launcher.py:0
msgid ""
"This software helps you organize and deliver your own medical images. It "
"does not interpret images, is not a medical device, and does not replace "
"professional radiological review. No warranty."
msgstr ""
"Perisian ini membantu anda menyusun dan menyerahkan imej perubatan anda "
"sendiri. Ia tidak mentafsir imej, bukan peranti perubatan, dan tidak "
"menggantikan semakan radiologi profesional. Tiada jaminan."

#: mia/gui/launcher.py:0
msgid "Open source · Private by design · No tracking"
msgstr "Sumber terbuka · Peribadi secara reka bentuk · Tiada penjejakan"

#: mia/gui/launcher.py:0
msgid "Made with ♥ by Fritanga"
msgstr "Dibuat dengan ♥ oleh Fritanga"

#: mia/gui/launcher.py:0 mia/gui/wizard/steps.py:0
msgid "Read our blog"
msgstr "Baca blog kami"

#: mia/gui:0
msgid "Add your studies"
msgstr "Tambah kajian anda"

#: mia/gui:0
msgid "Add Your Studies"
msgstr "Tambah Kajian Anda"

#: mia/gui:0
msgid "Copy discs, USB folders, or ZIP downloads into your project."
msgstr "Salin cakera, folder USB, atau muat turun ZIP ke dalam projek anda."

#: mia/gui:0
msgid "From a folder or USB"
msgstr "Daripada folder atau USB"

#: mia/gui:0
msgid "From a ZIP file"
msgstr "Daripada fail ZIP"

#: mia/gui:0
msgid ""
"Insert each CD — it copies and ejects automatically. You can also add "
"studies from a USB drive, a folder, or a ZIP downloaded from a hospital "
"portal. When everything's added, click Next."
msgstr ""
"Masukkan setiap CD — ia menyalin dan mengeluarkan secara automatik. Anda "
"juga boleh menambah kajian daripada pemacu USB, folder, atau fail ZIP yang "
"dimuat turun daripada portal hospital. Apabila semuanya telah ditambah, klik"
" Seterusnya."

#: mia/gui:0
msgid ""
"Insert a CD — it copies and ejects automatically. You can also add studies "
"from a USB drive, a folder, or a downloaded ZIP."
msgstr ""
"Masukkan CD — ia menyalin dan mengeluarkan secara automatik. Anda juga boleh"
" menambah kajian daripada pemacu USB, folder, atau fail ZIP yang dimuat "
"turun."

#: mia/gui:0
msgid ""
"1.  Add your studies — CDs, USB folders, or ZIP downloads\n"
"2.  Review everything we found\n"
"3.  Build one archive and copy it to a USB drive for your doctor"
msgstr ""
"1.  Tambah kajian anda — CD, folder USB, atau muat turun ZIP\n"
"2.  Semak semua yang kami jumpai\n"
"3.  Bina satu arkib dan salin ia ke pemacu USB untuk doktor anda"

#: mia/gui:0
msgid "Sources added so far: {n}"
msgstr "Sumber yang ditambah setakat ini: {n}"

#: mia/gui:0
msgid "Choose the folder or USB drive to import"
msgstr "Pilih folder atau pemacu USB untuk diimport"

#: mia/gui:0
msgid "Choose the ZIP file to import"
msgstr "Pilih fail ZIP untuk diimport"

#: mia/gui:0
msgid "Import"
msgstr "Import"

#: mia/gui:0
msgid "All files"
msgstr "Semua fail"

#: mia/gui:0
msgid "No medical images were found here. Copy anyway?"
msgstr "Tiada imej perubatan dijumpai di sini. Salin juga?"

#: mia/gui:0
msgid ""
"{files} files · {size}\n"
"{dicom} medical images detected.\n"
"\n"
"Copy everything into your project?"
msgstr ""
"{files} fail · {size}\n"
"{dicom} imej perubatan dikesan.\n"
"\n"
"Salin semuanya ke dalam projek anda?"

#: mia/gui:0
msgid ""
"{files} files · {size} inside the ZIP.\n"
