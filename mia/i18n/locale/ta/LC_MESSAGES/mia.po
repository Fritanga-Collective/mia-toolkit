#: mia/gui/menubar.py:43 mia/gui/menubar.py:116 mia/gui/menubar.py:185
msgid "About MIA Toolkit"
msgstr "MIA Toolkit பற்றி"

#: mia/gui/menubar.py:45 mia/gui/launcher.py:71
msgid "Made with ♥ by Fritanga"
msgstr "Fritanga அன்புடன் ♥ உருவாக்கியது"

#: mia/gui/menubar.py:62 mia/gui/menubar.py:67 mia/gui/menubar.py:74
#: mia/gui/menubar.py:118 mia/gui/menubar.py:183
msgid "Check for Updates…"
msgstr "புதுப்பிப்புகளைச் சரிபார்…"

#: mia/gui/menubar.py:63
msgid "Couldn't check for updates. Try again later."
msgstr "புதுப்பிப்புகளைச் சரிபார்க்க முடியவில்லை. பின்னர் முயற்சிக்கவும்."

#: mia/gui/menubar.py:68
#, python-brace-format
msgid ""
"Version {new} is available — you have {cur}.\n"
"\n"
"Open the download page?"
msgstr ""
"பதிப்பு {new} கிடைக்கிறது — உங்களிடம் {cur} உள்ளது.\n"
"\n"
"பதிவிறக்கப் பக்கத்தைத் திறக்கவா?"

#: mia/gui/menubar.py:75
#, python-brace-format
msgid "You're on the latest version ({v})."
msgstr "நீங்கள் சமீபத்திய பதிப்பில் உள்ளீர்கள் ({v})."

#: mia/gui/menubar.py:125
msgid "Open Project Folder"
msgstr "திட்டக் கோப்புறையைத் திற"

#: mia/gui/menubar.py:129
msgid "Exit"
msgstr "வெளியேறு"

#: mia/gui/menubar.py:130
msgid "File"
msgstr "கோப்பு"

#: mia/gui/menubar.py:134
msgid "Cut"
msgstr "வெட்டு"

#: mia/gui/menubar.py:134 mia/gui/report.py:155
msgid "Copy"
msgstr "நகலெடு"

#: mia/gui/menubar.py:135
msgid "Paste"
msgstr "ஒட்டு"

#: mia/gui/menubar.py:139
msgid "Select All"
msgstr "அனைத்தையும் தேர்ந்தெடு"

#: mia/gui/menubar.py:141
msgid "Edit"
msgstr "திருத்து"

#: mia/gui/menubar.py:146
msgid "Home"
msgstr "முகப்பு"

#: mia/gui/menubar.py:147 mia/gui/launcher.py:36 mia/gui/wizard/view.py:45
msgid "Guided Setup"
msgstr "வழிகாட்டப்பட்ட அமைப்பு"

#: mia/gui/menubar.py:148 mia/gui/rip_view.py:15 mia/gui/launcher.py:42
msgid "Add Your Studies"
msgstr "உங்கள் ஆய்வுகளைச் சேர்க்கவும்"

#: mia/gui/menubar.py:149 mia/gui/launcher.py:45 mia/gui/inventory_view.py:17
msgid "Build Inventory"
msgstr "பட்டியலை உருவாக்கு"

#: mia/gui/menubar.py:150 mia/gui/launcher.py:47 mia/gui/archive_view.py:16
msgid "Build Archive for Doctor"
msgstr "மருத்துவருக்கான காப்பகத்தை உருவாக்கு"

#: mia/gui/menubar.py:164
msgid "Language"
msgstr "மொழி"

#: mia/gui/menubar.py:165
msgid "Go"
msgstr "செல்"

#: mia/gui/menubar.py:170
msgid "Window"
msgstr "சாளரம்"

#: mia/gui/menubar.py:179 mia/gui/progress_panel.py:95
msgid "Report a problem…"
msgstr "சிக்கலைப் புகாரளி…"

#: mia/gui/menubar.py:187
msgid "Help"
msgstr "உதவி"

#: mia/gui/rip_session.py:62 mia/gui/import_flow.py:119
msgid "Please choose a folder to save copies to."
msgstr "நகல்களைச் சேமிக்க ஒரு கோப்புறையைத் தேர்ந்தெடுக்கவும்."

#: mia/gui/rip_session.py:67 mia/gui/import_flow.py:124
msgid "Couldn't create that folder. Choose another."
msgstr ""
"அந்தக் கோப்புறையை உருவாக்க முடியவில்லை. வேறு ஒன்றைத் தேர்ந்தெடுக்கவும்."

#: mia/gui/rip_session.py:76
msgid "Insert a disc…"
msgstr "ஒரு வட்டை (disc) உள்ளே போடவும்…"

#: mia/gui/rip_session.py:77
msgid "Ripping session started. Insert your first disc."
msgstr "நகலெடுக்கும் அமர்வு தொடங்கியது. உங்கள் முதல் வட்டை உள்ளே போடவும்."

#: mia/gui/rip_session.py:85 mia/gui/task_view.py:123
msgid "Stopping…"
msgstr "நிறுத்துகிறது…"

#: mia/gui/rip_session.py:97
#, python-brace-format
msgid "Ripping session ended. {n} disc(s) copied."
msgstr "நகலெடுக்கும் அமர்வு முடிந்தது. {n} வட்டு(கள்) நகலெடுக்கப்பட்டன."

#: mia/gui/rip_session.py:126
msgid "Insert a disc… (waiting)"
msgstr "ஒரு வட்டை உள்ளே போடவும்… (காத்திருக்கிறது)"

#: mia/gui/rip_session.py:133 mia/gui/import_flow.py:43
msgid "Already added"
msgstr "ஏற்கனவே சேர்க்கப்பட்டது"

#: mia/gui/rip_session.py:134
#, python-brace-format
msgid "“{name}” looks already added. Copy again?"
msgstr "“{name}” ஏற்கனவே சேர்க்கப்பட்டதாகத் தெரிகிறது. மீண்டும் நகலெடுக்கவா?"

#: mia/gui/rip_session.py:138
#, python-brace-format
msgid "Already added — skipping “{name}”."
msgstr "ஏற்கனவே சேர்க்கப்பட்டது — “{name}” தவிர்க்கப்படுகிறது."

#: mia/gui/rip_session.py:148
msgid "Copy this drive?"
msgstr "இந்த இயக்ககத்தை நகலெடுக்கவா?"

#: mia/gui/rip_session.py:149
#, python-brace-format
msgid "Copy this drive “{name}”?"
msgstr "“{name}” இயக்ககத்தை நகலெடுக்கவா?"

#: mia/gui/rip_session.py:160
#, python-brace-format
msgid "Ripping disc {n}: {name}…"
msgstr "வட்டு {n} நகலெடுக்கப்படுகிறது: {name}…"

#: mia/gui/rip_session.py:161
#, python-brace-format
msgid "Found disc “{name}”. Copying…"
msgstr "“{name}” வட்டு கண்டுபிடிக்கப்பட்டது. நகலெடுக்கிறது…"

#: mia/gui/rip_session.py:178 mia/gui/task_view.py:103
#: mia/gui/import_flow.py:177 mia/gui/import_flow.py:178
#: mia/gui/wizard/steps.py:77
msgid "Stopped."
msgstr "நிறுத்தப்பட்டது."

#: mia/gui/rip_session.py:184
msgid "Couldn't rip this disc. Remove it and insert another, or press Stop."
msgstr ""
"இந்த வட்டை நகலெடுக்க முடியவில்லை. அதை எடுத்துவிட்டு வேறு ஒன்றை உள்ளே "
"போடவும், அல்லது நிறுத்து என்பதை அழுத்தவும்."

#: mia/gui/rip_session.py:190
#, python-brace-format
msgid "✓ Disc copied: {c} files OK, {r} recovered, {f} could not be read."
msgstr ""
"✓ வட்டு நகலெடுக்கப்பட்டது: {c} கோப்புகள் சரி, {r} மீட்கப்பட்டன, {f} படிக்க "
"முடியவில்லை."

#: mia/gui/rip_session.py:198
#, python-brace-format
msgid "✓ Disc {n} done. Insert the next disc…"
msgstr "✓ வட்டு {n} முடிந்தது. அடுத்த வட்டை உள்ளே போடவும்…"

#: mia/gui/rip_session.py:207
msgid "Choose a disc"
msgstr "ஒரு வட்டைத் தேர்ந்தெடுக்கவும்"

#: mia/gui/rip_session.py:211
msgid "More than one drive looks like a disc. Which one should I copy?"
msgstr ""
"ஒன்றுக்கு மேற்பட்ட இயக்ககங்கள் வட்டாகத் தெரிகின்றன. எதை நகலெடுக்க வேண்டும்?"

#: mia/gui/rip_session.py:225
msgid "Rip this one"
msgstr "இதை நகலெடுக்கவும்"

#: mia/gui/rip_session.py:227
msgid "Skip for now"
msgstr "இப்போதைக்கு தவிர்க்கவும்"

#: mia/gui/task_view.py:38 mia/gui/wizard/view.py:62
msgid "‹ Back"
msgstr "‹ பின்செல்"

#: mia/gui/task_view.py:54
msgid "Stop"
msgstr "நிறுத்து"

#: mia/gui/task_view.py:92 mia/gui/wizard/steps.py:68
msgid "Working…"
msgstr "செயலாக்கப்படுகிறது…"

#: mia/gui/task_view.py:101 mia/gui/wizard/steps.py:75
msgid "Stopped on an error."
msgstr "ஒரு பிழையால் நிறுத்தப்பட்டது."

#: mia/gui/task_view.py:104
msgid "Stopped by you."
msgstr "உங்களால் நிறுத்தப்பட்டது."

#: mia/gui/task_view.py:106 mia/gui/wizard/steps.py:79
msgid "Done."
msgstr "முடிந்தது."

#: mia/gui/widgets.py:32
msgid "Choose…"
msgstr "தேர்ந்தெடு…"

#: mia/gui/progress_panel.py:40 mia/gui/progress_panel.py:50
msgid "Ready."
msgstr "தயார்."

#: mia/gui/progress_panel.py:72 mia/gui/progress_panel.py:306
msgid "▸ Show technical details"
msgstr "▸ தொழில்நுட்ப விவரங்களைக் காட்டு"

#: mia/gui/progress_panel.py:89
msgid "Save log…"
msgstr "பதிவைச் சேமி…"

#: mia/gui/progress_panel.py:91
msgid "Open log folder"
msgstr "பதிவுக் கோப்புறையைத் திற"

#: mia/gui/progress_panel.py:113
msgid "Writing the archive… this can take several minutes."
msgstr "காப்பகம் எழுதப்படுகிறது… இதற்குச் சில நிமிடங்கள் ஆகலாம்."

#: mia/gui/progress_panel.py:114
msgid "Writing the archive now. This can take several minutes — please wait…"
msgstr ""
"இப்போது காப்பகம் எழுதப்படுகிறது. இதற்குச் சில நிமிடங்கள் ஆகலாம் — தயவுசெய்து"
" காத்திருக்கவும்…"

#: mia/gui/progress_panel.py:145
#, python-brace-format
msgid "Copying {n} files… ({m:.0f}m elapsed)"
msgstr "{n} கோப்புகள் நகலெடுக்கப்படுகிறது… ({m:.0f} நிமி கடந்தது)"

#: mia/gui/progress_panel.py:147
#, python-brace-format
msgid "Copying {n} files…"
msgstr "{n} கோப்புகள் நகலெடுக்கப்படுகிறது…"

#: mia/gui/progress_panel.py:219
#, python-brace-format
msgid "files {done}/{total}"
msgstr "கோப்புகள் {done}/{total}"

#: mia/gui/progress_panel.py:222
#, python-brace-format
msgid "elapsed {t}"
msgstr "கழிந்த நேரம் {t}"

#: mia/gui/progress_panel.py:224
#, python-brace-format
msgid "ETA {t}"
msgstr "மீதி நேரம் {t}"

#: mia/gui/progress_panel.py:226
#, python-brace-format
msgid "{r:.0f}/s"
msgstr "{r:.0f}/வி"

#: mia/gui/progress_panel.py:297
msgid "▾ Hide technical details"
msgstr "▾ தொழில்நுட்ப விவரங்களை மறை"

#: mia/gui/progress_panel.py:310
msgid "Save technical log"
msgstr "தொழில்நுட்பப் பதிவைச் சேமி"

#: mia/gui/rip_view.py:19
msgid ""
"Insert a CD — it copies and ejects automatically. You can also add studies "
"from a USB drive, a folder, or a downloaded ZIP."
msgstr ""
"ஒரு CD-யை உள்ளே போடவும் — அது தானாகவே நகலெடுத்து வெளியேற்றும். ஒரு USB "
"இயக்ககம், ஒரு கோப்புறை, அல்லது பதிவிறக்கிய ZIP-இலிருந்தும் ஆய்வுகளைச் "
"சேர்க்கலாம்."

#: mia/gui/rip_view.py:23
msgid "Save copies to:"
msgstr "நகல்களைச் சேமிக்க:"

#: mia/gui/rip_view.py:30 mia/gui/wizard/steps.py:160
msgid "Start ripping"
msgstr "நகலெடுக்கத் தொடங்கு"

#: mia/gui/rip_view.py:34 mia/gui/wizard/steps.py:164
msgid "From a folder or USB"
msgstr "ஒரு கோப்புறை அல்லது USB-இலிருந்து"

#: mia/gui/rip_view.py:37 mia/gui/wizard/steps.py:167
msgid "From a ZIP file"
msgstr "ஒரு ZIP கோப்பிலிருந்து"

#: mia/gui/messages.py:61
msgid "Recovered a file after a retry."
msgstr "மீண்டும் முயன்ற பிறகு ஒரு கோப்பு மீட்கப்பட்டது."

#: mia/gui/messages.py:63
msgid "⚠ Could not read a file (see technical details)."
msgstr ""
"⚠ ஒரு கோப்பைப் படிக்க முடியவில்லை (தொழில்நுட்ப விவரங்களைப் பார்க்கவும்)."

#: mia/gui/messages.py:73
#, python-brace-format
msgid "Copying image {done} of {total}…"
msgstr "படம் {done}/{total} நகலெடுக்கப்படுகிறது…"

#: mia/gui/messages.py:75
#, python-brace-format
msgid "Copying file {done} of {total}…"
msgstr "கோப்பு {done} / {total} நகலெடுக்கப்படுகிறது…"

#: mia/gui/messages.py:77
#, python-brace-format
msgid "Scanning file {done} of {total}…"
msgstr "கோப்பு {done} / {total} வருடப்படுகிறது…"

#: mia/gui/messages.py:79
#, python-brace-format
msgid "Indexing image {done} of {total}…"
msgstr "படம் {done} / {total} அட்டவணைப்படுத்தப்படுகிறது…"

#: mia/gui/messages.py:81
#, python-brace-format
msgid "Working… {done} of {total}"
msgstr "வேலை நடக்கிறது… {total}-இல் {done}"

#: mia/gui/messages.py:88
msgid ""
"Permission denied. The destination may be read-only or locked. Try a "
"different folder, or check the drive isn't write-protected."
msgstr ""
"அனுமதி மறுக்கப்பட்டது. சேருமிடம் படிக்க-மட்டும் அல்லது "
"பூட்டப்பட்டிருக்கலாம். வேறு கோப்புறையை முயற்சிக்கவும், அல்லது இயக்ககம் "
"எழுத-தடைசெய்யப்படவில்லை என்பதைச் சரிபார்க்கவும்."

#: mia/gui/messages.py:91
msgid ""
"A needed file or folder was not found. A disc may have been ejected too "
"early, or a folder was moved."
msgstr ""
"தேவையான ஒரு கோப்பு அல்லது கோப்புறை கண்டுபிடிக்கப்படவில்லை. ஒரு வட்டு மிக "
"விரைவாக வெளியேற்றப்பட்டிருக்கலாம், அல்லது ஒரு கோப்புறை "
"நகர்த்தப்பட்டிருக்கலாம்."

#: mia/gui/messages.py:94
msgid "The disk is full. Free up space or choose a drive with more room."
msgstr ""
"வட்டு நிரம்பிவிட்டது. இடத்தைக் காலி செய்யவும் அல்லது அதிக இடமுள்ள "
"இயக்ககத்தைத் தேர்ந்தெடுக்கவும்."

#: mia/gui/messages.py:96
msgid "That location is read-only. Choose a different destination folder."
msgstr ""
"அந்த இடம் படிக்க-மட்டும். வேறு ஒரு சேருமிடக் கோப்புறையைத் தேர்ந்தெடுக்கவும்."

#: mia/gui/messages.py:97
msgid "Something went wrong. See the technical details below."
msgstr "ஏதோ தவறு நடந்தது. கீழே உள்ள தொழில்நுட்ப விவரங்களைப் பார்க்கவும்."

#: mia/gui/app.py:21 mia/gui/app.py:54 mia/gui/app.py:87
#: mia/gui/launcher.py:31
msgid "MIA Toolkit"
msgstr "MIA Toolkit"

#: mia/gui/app.py:55
msgid "A task is still running — stop it or let it finish first."
